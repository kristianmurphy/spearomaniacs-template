NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-06-01
NEXT_PUBLIC_SITE_NAME=Your Brand

# Optional (for preview/drafts later)
# SANITY_VIEWER_TOKEN=
# SANITY_PREVIEW_SECRET=
# SANITY_API_WRITE_TOKEN=
# ACCOUNT_SESSION_SECRET=

# Printful
# PRINTFUL_API_TOKEN=
# PRINTFUL_AUTO_SUBMIT_ORDERS=true

# Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional email sending for password reset
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# RESEND_API_KEY=
# EMAIL_FROM=noreply@example.com
# NEWSLETTER_ADMIN_TOKEN=
# NEWSLETTER_FROM_NAME=Your Brand
# RESEND_NEWSLETTER_AUDIENCE_ID=

# Checkout shipping countries
# SHOP_ALLOWED_COUNTRIES=AU,NZ,US,CA,GB

# Storefront pricing label
# SHOP_CURRENCY_CODE=AUD
